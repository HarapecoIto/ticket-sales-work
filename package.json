{
  "name": "ticket-sales",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "db:push:local": "dotenv -e .env.development.local -- prisma db push",
    "db:pull:local": "dotenv -e .env.development.local -- prisma db pull",
    "postinstall": "prisma generate",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@line/bot-sdk": "^11.0.0",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/client": "^6.19.0",
    "marked": "^18.0.5",
    "next": "^16.0.3",
    "prisma": "^6.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vercel/node": "^5.7.16",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.59.2"
  }
}
