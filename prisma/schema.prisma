generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model line_group_event_relations {
  ciel_id    String
  source_id  String
  event_code String

  @@id([ciel_id, source_id, event_code])
}

model conversation_states {
  ciel_id    String
  source_id  String
  state      String
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@id([ciel_id, source_id])
}

model spreadsheets {
  ciel_id    String
  url        String
  event_code String

  @@id([ciel_id, url]) 
}

model asana_tasks {
  ciel_id    String
  task_id    String
  event_code String

  @@id([ciel_id, task_id, event_code])
}

model daily_ticket_sales {
  event_code         String
  concert_short_name String
  campaign_name      String
  play_guide         String
  ticket             String
  aggregated_at      DateTime @db.Timestamptz(6)
  applied_number     Int?
  reserved_number    Int?
  confirmed_number   Int?

  @@id([event_code, concert_short_name, campaign_name, play_guide, ticket, aggregated_at])
}
