generator client {
  provider      = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 日次販売データ
// 非正規化
model_daily_sales {
  event_code               String @db.VarChar(20)
  performance_short_name   String @db.VarChar(20)
  campaign_name            String @db.VarChar(20)
  aggregated_at            @default(now()) @db.Timestamptz(6)
  ticket_1?                String @db.VarChar(20)
  reservation_1?           BigInt
  sales_1?                 BigInt
  ticket_2?                String @db.VarChar(20)
  reservation_2?           BigInt
  sales_2?                 BigInt
  ticket_3?                String @db.VarChar(20)
  reservation_3?           BigInt
  sales_3?                 BigInt
  ticket_4?                String @db.VarChar(20)
  reservation_4?           BigInt
  sales_4?                 BigInt
  ticket_5?                String @db.VarChar(20)
  reservation_5?           BigInt
  sales_5?                 BigInt
}

// 日次販売明細
// 非正規化
model daily_sales_details {
  daily_sales_detail_id    @default(autoincrement())
  event_code               String @db.VarChar(20)               // あえて外部キーは用いない
  performance_short_name   String @db.VarChar(20)　　　　　　    // あえて外部キーは用いない　　　　　
  campaign_name            String @db.VarChar(20)               // あえて外部キーは用いない
  aggregated_at            @default(now()) @db.Timestamptz(6)   // あえて外部キーは用いない
  play_guide               String @db.VarChar(20)
  ticket_1?                String @db.VarChar(20)
  reservation_1?           BigInt
  sales_1?                 BigInt
  ticket_2?                String @db.VarChar(20)
  reservation_2?           BigInt
  sales_2?                 BigInt
  ticket_3?                String @db.VarChar(20)
  reservation_3?           BigInt
  sales_3?                 BigInt
  ticket_4?                String @db.VarChar(20)
  reservation_4?           BigInt
  sales_4?                 BigInt
  ticket_5?                String @db.VarChar(20)
  reservation_5?           BigInt
  sales_5?                 BigInt
}
