generator client {
  provider      = "prisma-client-js"
  compilerBuild = "small"
}

datasource db {
  provider = "postgresql"
}

model line_group_event_relations {
  source_id  String
  event_code String
  ciel_id    String

  @@id([ciel_id, source_id, event_code])
}

model conversation_states {
  ciel_id    String
  source_id  String
  state      String
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@id([ciel_id, source_id])
}

model asana_tasks {
  task_id    String
  event_code String
  ciel_id    String

  @@id([ciel_id, task_id])
}

model daily_ticket_sales {
  event_code         String
  concert_short_name String
  campaign_name      String
  play_guide         String
  ticket             String
  aggregated_at      DateTime @db.Timestamptz(6)
  applied_number     Int?
  reserved_number    Int?
  confirmed_number   Int?

  @@id([event_code, concert_short_name, campaign_name, play_guide, ticket, aggregated_at])
}

model daily_ticket_sales_v2 {
  project_code         String
  event_page_code      String
  reception            String
  internal_ticket_name String
  aggregated_at        DateTime @db.Timestamptz(6)
  applied_number       Int?
  reserved_number      Int?
  confirmed_number     Int?

  @@id([project_code, event_page_code, reception, internal_ticket_name, aggregated_at])
}

model scraping_triggered {
  project_code String
  triggered_at DateTime @db.Timestamptz(6)
  meta_info    String

  @@id([project_code, triggered_at])
}

model projects {
  project_code String @id
  line_keyword String
}
