generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model daily_sales_details {
  event_code         String
  concert_short_name String
  aggregated_at      DateTime @default(now()) @db.Timestamptz(6)
  campaign_name      String
  play_guide         String
  ticket_1           String?
  reservation_1      BigInt?
  sales_1            BigInt?
  ticket_2           String?
  reservation_2      BigInt?
  sales_2            BigInt?
  ticket_3           String?
  reservation_3      BigInt?
  sales_3            BigInt?
  ticket_4           String?
  reservation_4      BigInt?
  sales_4            BigInt?
  ticket_5           String?
  reservation_5      BigInt?
  sales_5            BigInt?

  @@id([event_code, concert_short_name, aggregated_at, campaign_name, play_guide])
}

model line_group_event_relations {
  ciel_id    String
  source_id  String
  event_code String

  @@id([ciel_id, source_id, event_code])
}

model conversation_states {
  ciel_id    String
  source_id  String
  state      String
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@id([ciel_id, source_id])
}

model spreadsheets {
  ciel_id    String
  url        String
  event_code String

  @@id([ciel_id, url]) 
}

model asana_tasks {
  ciel_id    String
  task_id    String
  event_code String

  @@id([ciel_id, task_id])
}

model daily_ticket_sales {
  event_code         String
  concert_short_name String
  campaign_name      String
  play_guide         String
  ticket             String
  aggregated_at      DateTime @db.Timestamptz(6)
  applied_number     Int?
  reserved_number    Int?
  confirmed_number   Int?

  @@id([event_code, concert_short_name, campaign_name, play_guide, ticket, aggregated_at])
}
