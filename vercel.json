{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/batch/copy-to-sheet",
      "schedule": "5 9 * * *"
    },
    {
      "path": "/batch/deliver-line",
      "schedule": "10 9 * * *"
    }
  ]
}
