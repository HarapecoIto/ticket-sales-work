{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/spreadsheets/batch/",
      "schedule": "50 8 * * *"
    },
    {
      "path": "/line/batch/",
      "schedule": "0 9 * * *"
    }
  ]
}
