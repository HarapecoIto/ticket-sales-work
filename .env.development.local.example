# NextAuth.js settings
# ローカル開発環境用: http://localhost:3000
# Vercel Preview環境: 設定不要（VERCEL_URLが自動使用される）
# Vercel Production環境: 本番ドメインを設定（例: https://yourdomain.com）
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
# ローカル開発では不要。Vercel Preview環境のみtrueに設定
# AUTH_TRUST_HOST="true"

# batch settigns
CRON_SECRET="my_secret_value"

# neon database connection settings
DATABASE_URL="postgresql://..."
